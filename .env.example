# Orígenes permitidos para CORS (separados por coma)
MIPROXIMOCARRO_CORS_ORIGINS=http://localhost:5173
# Ruta de la base de datos SQLite
MIPROXIMOCARRO_DB_PATH=db/cars.db
# Límite de solicitudes por IP
MIPROXIMOCARRO_RATE_LIMIT=120/minute
# Desactiva la consulta de TRM en línea (usa el valor de respaldo)
MIPROXIMOCARRO_TRM_OFFLINE=0
